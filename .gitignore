
# ============================================
# Django + Cloudflare Workers + D1
# Project: django-cloudflare-test
# ============================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python virtual environments
.venv/
.venv-workers/
venv/
env/
ENV/

# Python packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Python testing and analysis
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Django local database
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal

# Django logs and runtime files
*.log
*.pid
local_settings.py

# Django uploaded files
media/

# Django collected static files
staticfiles/

# Cloudflare Wrangler local state
# Includes local D1 databases
.wrangler/

# Cloudflare Worker generated files
.wrangler-tmp/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Local Cloudflare secrets
.dev.vars
.dev.vars.*
!.dev.vars.example

# VS Code local settings
.vscode/*
!.vscode/extensions.json

# IDE settings
.idea/
*.iml

# Windows files
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Linux temporary files
*~
*.swp
*.swo
.nfs*

# Temporary files
*.tmp
*.temp
*.bak
*.orig

# Local archives
*.zip
*.tar.gz
*.7z
